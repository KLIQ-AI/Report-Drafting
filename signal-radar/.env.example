# --- Core ---
SIGNAL_RADAR_DB=signal_radar.db
# How often active monitors run automatically (minutes). 0 disables the scheduler.
RUN_INTERVAL_MINUTES=360

# --- LinkedIn data provider: "mock" (demo data) or "apify" ---
LINKEDIN_PROVIDER=mock
APIFY_TOKEN=
# Apify actor IDs (username~actor-name). Pick actors from the Apify store and
# adjust app/providers/apify.py field mapping if their output differs.
APIFY_POST_SEARCH_ACTOR=
APIFY_PROFILE_POSTS_ACTOR=
APIFY_POST_REACTIONS_ACTOR=
APIFY_POST_COMMENTS_ACTOR=

# --- Enrichment: "mock" or "none" ---
ENRICHMENT_PROVIDER=mock

# --- AI intent scoring (falls back to heuristics when unset) ---
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-opus-5-5

# --- Hosting ---
# When set, every /api call needs header X-API-Key (or ?api_key= for CSV links).
API_KEY=
# Browser origins allowed to call the API (default: Lovable domains + localhost).
CORS_ORIGIN_REGEX=
# Create two demo monitors on first boot when using the mock provider.
SEED_DEMO=true
